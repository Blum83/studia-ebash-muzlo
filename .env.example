# Engine: only "acestep" for now
ENGINE=acestep
# Absolute paths; default to <repo>/models and <repo>/data/outputs
# MODELS_DIR=/workspace/models
# OUTPUT_DIR=/workspace/data/outputs
DEVICE=cuda

# ACE-Step 1.5. Defaults = 12-16 GB GPU (RTX 5070). For a 24 GB+ Linux box:
#   ACESTEP_DIT_MODEL=acestep-v15-xl-turbo ACESTEP_LM_MODEL=acestep-5Hz-lm-1.7B
#   ACESTEP_LM_BACKEND=vllm ACESTEP_QUANTIZATION=none OFFLOAD_TO_CPU=false
ACESTEP_DIT_MODEL=acestep-v15-turbo
ACESTEP_LM_MODEL=acestep-5Hz-lm-0.6B
ACESTEP_LM_BACKEND=pt
ACESTEP_QUANTIZATION=int8_weight_only
ACESTEP_COMPILE=false
OFFLOAD_TO_CPU=true
OFFLOAD_DIT_TO_CPU=false
